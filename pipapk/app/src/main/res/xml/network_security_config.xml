<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext (HTTP) for all traffic. The pipapk always connects to
         a self-hosted local server (127.0.0.1:3000) or a LAN address.
         HTTPS is not used for these connections. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>